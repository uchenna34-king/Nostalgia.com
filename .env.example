# Copy to .env and fill in when you have real credentials.
# The app runs WITHOUT these using dev fallbacks.

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-me"

# Google OAuth (optional — dev-mock login is used if blank)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (optional — stub checkout is used if blank)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Database
DATABASE_URL="file:./dev.db"
