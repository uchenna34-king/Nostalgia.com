# Copy to .env and fill in when you have real credentials.
# The app runs WITHOUT these using dev fallbacks.

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-me"

# Google OAuth (optional — dev-mock login is used if blank)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (optional — stub checkout is used if blank)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Database
DATABASE_URL="file:./dev.db"



# DIRECT_URL: Neon's direct (unpooled) connection string, used only by `prisma migrate`
# commands. DATABASE_URL above must be Neon's pooled string (hostname contains "-pooler").
DIRECT_URL="" # direct/unpooled - migrations only; DATABASE_URL takes the pooled string (hostname has "-pooler")

# Demo login gate (UAT only) - the literal string "true" is the only value that opens it;
# unset or any other value (including "false") keeps it closed.
ALLOW_DEMO_LOGIN=""

# Stripe webhook signing secret - from `stripe listen` locally, or the Stripe Dashboard
# webhook endpoint for the deployed environment. These are different values.
STRIPE_WEBHOOK_SECRET=""

# Resend (transactional email)
RESEND_API_KEY=""
EMAIL_FROM="" # e.g. "Nostalgia <onboarding@resend.dev>" until a sending domain is verified - until then, mail only reaches the owner's own Resend account address (see D-06a)

# Owner identity - the address requireOwner() (lib/admin.ts) matches against to grant /admin
OWNER_EMAIL=""
